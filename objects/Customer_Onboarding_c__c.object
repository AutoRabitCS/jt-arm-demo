    <label>Customer Onboarding</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>ONB-{0000}</displayFormat>
        <label>Onboarding Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Customer Onboardings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Require_Security_Review_For_Launch</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Stage__c, &quot;Ready for Launch&quot;),
    NOT(Security_Review_Complete__c)
)</errorConditionFormula>
        <errorDisplayField>Stage__c</errorDisplayField>
        <errorMessage>Security Review must be complete before the customer can move to Ready for Launch.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>